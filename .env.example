# Copy these settings into the server environment only. Never commit a real key.
AI_BASE_URL=https://api.985la.cn
AI_MODEL=gpt-4o-mini
AI_API_KEY=replace-with-a-new-key
AI_TIMEOUT_SECONDS=35
# Set this to the exact public classroom origin when the UI and API are separate.
CORS_ORIGIN=https://your-pages-origin.example
# The Docker/Render command overrides this to 0.0.0.0.
CLASSROOM_HOST=0.0.0.0
